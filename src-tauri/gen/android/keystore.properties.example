# Template for Android release signing.
# Copy this file to `keystore.properties` (which is gitignored) and fill in real values.
# WARNING: NEVER commit `keystore.properties` or any .jks / .keystore / .p12 / .pfx file!

storeFile=../path/to/release.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=CHANGE_ME_KEY_ALIAS
keyPassword=CHANGE_ME_KEY_PASSWORD
